{
  "name": "jd-today-crawler",
  "version": "1.0.0",
  "description": "京东「今日抢购」活动页全量商品采集：SSR 楼层解析 + 推荐流分页 + 完整性校验",
  "main": "src/cli.js",
  "bin": {
    "jd-today": "src/cli.js"
  },
  "scripts": {
