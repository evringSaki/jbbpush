# 复制为 deploy/.env 后填写（docker compose 会自动读取）
# cp .env.example .env

# ── 无需京东 Cookie：桌面 UA + Chromium 已能抓全 29 条（2026-11-06 起）──

# 推送渠道：wecom / feishu / dingtalk / bark / serverchan / pushplus / telegram / generic
NOTIFY_CHANNEL=pushplus

# PushPlus 的 token（微信关注「pushplus 推送加」公众号）
NOTIFY_TOKEN="你的PUSHPLUS_TOKEN"

# 其他通道用 NOTIFY_URL：
# 企业微信群机器人：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# 飞书：https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# 钉钉：https://oapi.dingtalk.com/robot/send?access_token=xxx
# Bark(iOS)：https://api.day.app/你的key
# Server酱：https://sctapi.ftqq.com/SCTxxxx.send
NOTIFY_URL=""

# new=只推新上架（推荐，最省消息额度）
# change=新上架 + 下架 + 价格/状态变动
# always=每轮都推（288 条/天，会超 PushPlus 免费额度）
NOTIFY_MODE=new

# 采集周期（分钟）
PUSH_INTERVAL=5
